# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage
data/*_test_db.json
backend/data/*_test_db.json
data/*.tmp.*
backend/data/*.tmp.*
*.log

# build outputs
.next/
frontend/.next/
out/
build/
dist/
backend/dist/

# environment & secret keys
.env
.env*.local
.env.development
.env.test
.env.production
.env*
!.env.example

# security & credentials
*.pem
*.key
*.cert
*.p12
*.crt

# debug & runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# system & OS files
.DS_Store
Thumbs.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
