# ==============================================================================
# BloodLink – Blood Donor Finder Environment Configuration
# ==============================================================================
# In Demo Mode, all variables below are optional. BloodLink automatically falls
# back to an interactive local persistence engine and simulated provider adapters.
#
# To connect production cloud services, copy this file to .env.local:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth (Required for Supabase cloud mode)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key is used exclusively on the server for admin operations & migrations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Resend Email Notifications (Transactional donor alerts)
# ------------------------------------------------------------------------------
# If left empty, notifications log as "provider_not_configured" safely.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=BloodLink Alerts <notifications@bloodlink.org>

# ------------------------------------------------------------------------------
# 3. Twilio SMS Notifications (Emergency SMS alerts)
# ------------------------------------------------------------------------------
# If left empty, notifications log as "provider_not_configured" safely.
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 4. Cloudflare Turnstile Bot & Abuse Protection (CAPTCHA)
# ------------------------------------------------------------------------------
# In development/test, test tokens (1x0000000000000000000000000000000AA) pass automatically.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx_your_turnstile_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAAx_your_turnstile_secret_key

# ------------------------------------------------------------------------------
# 5. Web Push VAPID Keys (Browser Push Notifications)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ------------------------------------------------------------------------------
# 6. Sentry Error & Performance Monitoring (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# ------------------------------------------------------------------------------
# 7. Local File Storage / Test DB Configuration (Development only)
# ------------------------------------------------------------------------------
# BLOODLINK_DB_FILE=data/bloodlink_custom_db.json
